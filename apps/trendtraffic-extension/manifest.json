{
  "manifest_version": 3,
  "name": "TrendTraffic — помощник (Flow · NotebookLM · HeyGen)",
  "version": "1.3.25",
  "description": "Единое расширение TrendTraffic: мост с Google Flow (Veo), Google NotebookLM (Hotebook) и HeyGen (говорящие головы UGC по вашей подписке). Очередь задач в реальном браузере, автоматизация генераций и обмен с Галереей. Ставится один раз — панель включается на том сервисе, где открыта вкладка.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TrendTraffic — помощник (Flow · NotebookLM · HeyGen)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "downloads", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://labs.google/*",
    "https://notebooklm.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.ggpht.com/*",
    "https://*.gstatic.com/*",
    "https://*.google.com/*",
    "https://app.heygen.com/*",
    "https://api.heygen.com/*",
    "https://upload.heygen.com/*",
    "https://*.heygen.com/*",
    "https://*.heygen.ai/*",
    "https://app.trendtraffic.pro/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/tools/flow*", "https://labs.google/fx/*/tools/flow*"],
      "js": ["src/content-flow.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["src/content-notebook.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://app.heygen.com/*"],
      "js": ["src/content-heygen.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://app.trendtraffic.pro/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["src/content-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": ["https://labs.google/*"]
    },
    {
      "resources": ["src/injected-nlm.js"],
      "matches": ["https://notebooklm.google.com/*"]
    },
    {
      "resources": ["src/injected-heygen.js"],
      "matches": ["https://app.heygen.com/*"]
    }
  ]
}
